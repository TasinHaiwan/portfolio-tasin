---
import Layout from '../layouts/Layout.astro';
import { SOCIAL_LINKS } from '../consts';
---

<Layout title="Contact — Tasin" description="Have an app idea or need help growing one? Tell me about it.">
	<section class="contact-hero">
		<h1>Let's build your software</h1>
		<p>Have an app idea or need help growing one? Tell me about it.</p>
	</section>

	<form name="contact" method="POST" data-netlify="true" class="contact-form">
		<input type="hidden" name="form-name" value="contact" />
		<label>Name<input type="text" name="name" required /></label>
		<label>Email<input type="email" name="email" required /></label>
		<label>Message<textarea name="message" rows="5" required></textarea></label>
		<button type="submit">Send</button>
	</form>

	<p class="alt-contact">
		Or reach me on <a href={SOCIAL_LINKS.whatsapp} target="_blank" rel="noopener noreferrer"
			>WhatsApp</a
		>{' '}
		or via <a href={`mailto:${SOCIAL_LINKS.email}`}>email</a>.
	</p>
</Layout>

<style>
	.contact-hero {
		text-align: center;
		margin-bottom: 2rem;
	}
	.contact-hero p {
		color: var(--text-muted);
	}
	.contact-form {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}
	.contact-form label {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		font-size: 0.9rem;
		color: var(--text-muted);
	}
	.contact-form input,
	.contact-form textarea {
		background: var(--surface);
		border: 1px solid var(--border);
		color: var(--text);
		padding: 0.7rem;
		border-radius: 8px;
		font-family: inherit;
	}
	.contact-form button {
		background: var(--accent);
		color: white;
		border: none;
		padding: 0.8rem;
		border-radius: 8px;
		font-weight: 600;
		cursor: pointer;
		margin-top: 0.5rem;
	}
	.contact-form button:hover {
		background: var(--accent-dark);
	}
	.alt-contact {
		text-align: center;
		margin-top: 1.5rem;
		color: var(--text-muted);
	}
</style>
