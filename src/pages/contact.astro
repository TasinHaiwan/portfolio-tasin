<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Contact — Tasin</title>
</head>
<body>
  <nav>
    <a href="/">Home</a>
    <a href="/blog">Blog</a>
    <a href="/contact">Contact</a>
  </nav>

  <section class="contact-hero">
    <h1>Let's build your software</h1>
    <p>Have an app idea or need help growing one? Tell me about it.</p>
  </section>

  <form name="contact" method="POST" data-netlify="true" class="contact-form">
    <input type="hidden" name="form-name" value="contact" />
    <label>Name<input type="text" name="name" required /></label>
    <label>Email<input type="email" name="email" required /></label>
    <label>Message<textarea name="message" rows="5" required></textarea></label>
    <button type="submit">Send</button>
  </form>

  <p class="alt-contact">
    Or reach me on <a href="https://wa.me/8801765886380" target="_blank">WhatsApp</a>
  </p>
</body>
</html>

<style>
  :root {
    --bg: #0f0f10; --text: #f2f2f2; --muted: #a0a0a5;
    --accent: #4f8cff; --card-bg: #1a1a1c;
  }
  body {
    background: var(--bg); color: var(--text);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    max-width: 600px; margin: 0 auto; padding: 2rem 1.5rem; line-height: 1.6;
  }
  nav { display: flex; justify-content: center; gap: 2rem; padding: 1rem 0 3rem; }
  nav a { color: var(--muted); text-decoration: none; font-weight: 500; }
  .contact-hero { text-align: center; margin-bottom: 2rem; }
  .contact-form { display: flex; flex-direction: column; gap: 1rem; }
  .contact-form label { display: flex; flex-direction: column; gap: 0.4rem; font-size: 0.9rem; color: var(--muted); }
  .contact-form input, .contact-form textarea {
    background: var(--card-bg); border: 1px solid #333; color: var(--text);
    padding: 0.7rem; border-radius: 8px; font-family: inherit;
  }
  .contact-form button {
    background: var(--accent); color: white; border: none;
    padding: 0.8rem; border-radius: 8px; font-weight: 600; cursor: pointer; margin-top: 0.5rem;
  }
  .alt-contact { text-align: center; margin-top: 1.5rem; color: var(--muted); }
  .alt-contact a { color: var(--accent); }
</style>