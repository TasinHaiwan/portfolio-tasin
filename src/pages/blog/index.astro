---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Layout title="Blog — Tasin" description="Thoughts on building and growing software products.">
	<section class="blog-hero">
		<h1>Blog</h1>
		<p>Thoughts on building and growing software products.</p>
	</section>

	{
		posts.length > 0 ? (
			<section class="post-list">
				{posts.map((post) => (
					<a href={`/blog/${post.id}/`} class="post-card">
						<h2>{post.data.title}</h2>
						<p class="post-date">
							{post.data.pubDate.toLocaleDateString('en-US', {
								year: 'numeric',
								month: 'long',
								day: 'numeric',
							})}
						</p>
						<p class="post-desc">{post.data.description}</p>
					</a>
				))}
			</section>
		) : (
			<p class="empty-state">New posts coming soon.</p>
		)
	}
</Layout>

<style>
	.blog-hero {
		text-align: center;
		margin-bottom: 2.5rem;
	}
	.blog-hero p {
		color: var(--text-muted);
	}
	.empty-state {
		text-align: center;
		color: var(--text-muted);
	}
	.post-list {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}
	.post-card {
		display: block;
		background: var(--surface);
		border: 1px solid var(--border);
		padding: 1.5rem;
		border-radius: 12px;
		text-decoration: none;
		color: var(--text);
		transition: transform 0.15s ease;
	}
	.post-card:hover {
		transform: translateY(-2px);
	}
	.post-card h2 {
		margin: 0 0 0.4rem;
		font-size: 1.3rem;
	}
	.post-date {
		color: var(--text-muted);
		font-size: 0.85rem;
		margin: 0 0 0.6rem;
	}
	.post-desc {
		color: var(--text-muted);
		margin: 0;
	}
</style>
