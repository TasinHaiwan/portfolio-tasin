---
import { getCollection } from 'astro:content';
const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Blog — Tasin</title>
</head>
<body>
  <nav>
    <a href="/">Home</a>
    <a href="/blog">Blog</a>
    <a href="/contact">Contact</a>
  </nav>

  <section class="blog-hero">
    <h1>Blog</h1>
    <p>Thoughts on building and growing software products.</p>
  </section>

  <section class="post-list">
    {posts.map((post) => (
      <a href={`/blog/${post.slug}/`} class="post-card">
        <h2>{post.data.title}</h2>
        <p class="post-date">{post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</p>
        <p class="post-desc">{post.data.description}</p>
      </a>
    ))}
  </section>
</body>
</html>

<style>
  :root {
    --bg: #0f0f10; --text: #f2f2f2; --muted: #a0a0a5;
    --accent: #4f8cff; --card-bg: #1a1a1c;
  }
  body {
    background: var(--bg); color: var(--text);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    max-width: 700px; margin: 0 auto; padding: 2rem 1.5rem; line-height: 1.6;
  }
  nav { display: flex; justify-content: center; gap: 2rem; padding: 1rem 0 3rem; }
  nav a { color: var(--muted); text-decoration: none; font-weight: 500; }
  nav a:hover { color: var(--text); }
  .blog-hero { text-align: center; margin-bottom: 2.5rem; }
  .blog-hero h1 { font-size: 2.5rem; margin-bottom: 0.3rem; }
  .blog-hero p { color: var(--muted); }
  .post-list { display: flex; flex-direction: column; gap: 1rem; }
  .post-card {
    display: block;
    background: var(--card-bg);
    padding: 1.5rem;
    border-radius: 12px;
    text-decoration: none;
    color: var(--text);
    transition: transform 0.15s ease;
  }
  .post-card:hover { transform: translateY(-2px); }
  .post-card h2 { margin: 0 0 0.4rem; font-size: 1.3rem; }
  .post-date { color: var(--muted); font-size: 0.85rem; margin: 0 0 0.6rem; }
  .post-desc { color: #ccc; margin: 0; }
</style>