---
import Layout from '../layouts/Layout.astro';

const description =
	'Software Engineer with 5+ years building apps at scale, now combining engineering with growth strategy.';
---

<Layout title="About — Tasin" description={description}>
	<article class="prose">
		<h1>About</h1>

		<p>
			I'm Tasin, a software engineer focused on Android, Flutter, and Kotlin Multiplatform. Over
			the past 5+ years I've built and shipped apps used by more than a million people, working
			across the full stack of mobile product development — from architecture and native
			performance to the release process that gets an app in front of real users.
		</p>

		<p>
			I'm the Co-Founder &amp; CTO of <strong>Sôrolikoron</strong>, a platform connecting users
			with trusted representatives for academic, legal, and administrative tasks. I also built <strong
				>Better Muslim</strong
			>, a Flutter-based Islamic habit tracker.
		</p>

		<p>
			Lately I've been combining that engineering background with growth strategy — helping
			founders not just build their product, but figure out how to get it in front of the people
			who need it.
		</p>

		<p>
			If you're working on an app idea or trying to grow one, <a href="/contact">get in touch</a
			>.
		</p>
	</article>
</Layout>

<style>
	.prose h1 {
		margin-bottom: 1.5rem;
	}
</style>
