---
import Layout from '../layouts/Layout.astro';
import { SITE_DESCRIPTION } from '../consts';

const projects = [
	{
		name: 'Sôrolikoron',
		description:
			'Platform connecting users with trusted representatives for academic, legal, and administrative tasks.',
	},
	{
		name: 'Better Muslim',
		description: 'Flutter-based Islamic habit tracker app.',
	},
];
---

<Layout title="Tasin – Mobile & Backend Developer" description={SITE_DESCRIPTION} wide>
	<section class="hero">
		<h1>Tasin</h1>
		<p class="subtitle">Mobile &amp; Backend Developer, Growth Strategist</p>
		<p class="tagline">I build apps and help founders grow them.</p>
		<a href="/contact" class="cta">Let's build your software →</a>
	</section>

	<section class="about">
		<h2>About</h2>
		<p>
			5+ years building apps at scale (1M+ users). Co-Founder &amp; CTO of Sôrolikoron. Currently
			combining engineering with growth strategy to help founders build and scale products.
		</p>
	</section>

	<section class="projects">
		<h2>Selected Work</h2>
		<div class="project-grid">
			{
				projects.map((project) => (
					<div class="project-card">
						<h3>{project.name}</h3>
						<p>{project.description}</p>
						<span class="coming-soon">Link coming soon</span>
					</div>
				))
			}
		</div>
	</section>

	<section class="services">
		<h2>Services</h2>
		<div class="service-grid">
			<div class="service-card">App Development</div>
			<div class="service-card">Growth Strategy</div>
		</div>
	</section>
</Layout>

<style>
	.hero {
		text-align: center;
		padding: 1.25rem 0 1.25rem;
	}
	.hero h1 {
		font-size: 2.75rem;
		margin: 0;
	}
	.subtitle {
		color: var(--text-muted);
		font-size: 1.2rem;
		margin-top: 0.4rem;
	}
	.tagline {
		margin-top: 0.4rem;
		color: var(--text-muted);
	}
	.cta {
		display: inline-block;
		margin-top: 1rem;
		padding: 0.7rem 1.5rem;
		background: var(--accent);
		color: white;
		text-decoration: none;
		border-radius: 8px;
		font-weight: 600;
	}
	.cta:hover {
		background: var(--accent-dark);
	}
	section {
		margin: 1.25rem 0;
	}
	.about p {
		max-width: 640px;
	}
	.project-grid,
	.service-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: 1rem;
	}
	.project-card,
	.service-card {
		background: var(--surface);
		border: 1px solid var(--border);
		padding: 1.5rem;
		border-radius: 12px;
	}
	.project-card h3 {
		margin-top: 0;
	}
	.coming-soon {
		display: inline-block;
		margin-top: 0.5rem;
		font-size: 0.85rem;
		color: var(--text-muted);
		font-style: italic;
	}
	.service-card {
		text-align: center;
		font-weight: 600;
		color: var(--text);
	}
</style>
